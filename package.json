{
  "name": "ballast",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contracts": "python3 -m pytest tests/direct -v",
    "lint:contracts": "python3 scripts/lint-contracts.py",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "deploy:contracts": "node --env-file=.env.local --import tsx scripts/deploy.ts",
    "test:integration": "python3 scripts/review-workflow.py",
    "test:browser": "playwright test",
    "test:integration:smoke": "node --env-file=.env.local --import tsx scripts/integration.ts",
    "verify:deployment": "node --env-file=.env.local --import tsx scripts/verify-deployment.ts",
    "test:account": "node scripts/account-test-browser.mjs"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@neondatabase/serverless": "^1.0.2",
    "@privy-io/react-auth": "3.49.1",
    "@privy-io/server-auth": "1.32.5",
    "genlayer-js": "1.1.8",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "viem": "^2.38.0",
    "workflow": "5.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "type": "module",
  "engines": {
    "node": "22.x"
  }
}
