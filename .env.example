NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
DATABASE_URL=
# Generate once with openssl rand -hex 32. Back up securely. Never rotate without reencrypting custody keys.
CUSTODY_MASTER_KEY=
# Deployment only. Never used to relay user actions.
GENLAYER_DEPLOYER_KEY=
GENLAYER_RPC_URL=https://studio.genlayer.com/api

# Dedicated sponsored signer; never use the deployer or a user custody key.
BALLAST_SPONSOR_KEY=
# Authenticates the daily background dispatcher.
CRON_SECRET=

# Required for atomic Workflow starts on Vercel (build and runtime).
WORKFLOW_VERCEL_EXPERIMENTAL_START_HOOK=1
